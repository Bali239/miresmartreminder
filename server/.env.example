# ==============================================================================
# REMINDLY BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-reminder?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# Email Sender Address
MAIL_FROM="Mira" <no-reply@yourdomain.com>

# ------------------------------------------------------------------------------
# PROFILE 1: DEVELOPMENT (Mailtrap - Safe Sandbox)
# ------------------------------------------------------------------------------
# In Mailtrap, create an account at https://mailtrap.io -> Inboxes -> SMTP Settings
EMAIL_PROVIDER=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user_here
SMTP_PASS=your_mailtrap_password_here

# ------------------------------------------------------------------------------
# PROFILE 2: PRODUCTION (Brevo SMTP - Port 587)
# ------------------------------------------------------------------------------
# Create a free account at https://brevo.com -> Transactional -> Settings -> SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_account_email@domain.com
# SMTP_PASS=your_brevo_smtp_key_here

# ------------------------------------------------------------------------------
# PROFILE 3: PRODUCTION HTTP API FALLBACK (If Port 587/25/465 is blocked by Host)
# ------------------------------------------------------------------------------
# Many cloud hosts (Render, Railway, AWS EC2, DigitalOcean) block outbound SMTP ports.
# To bypass this without port blocks, set EMAIL_PROVIDER to brevo_api or resend:

# Option A: Brevo HTTP API
# EMAIL_PROVIDER=brevo_api
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend HTTP API
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_resend_api_key_here
