# 1. Base image with lightweight Node 20
FROM node:20-alpine

# 2. Set working directory inside container
WORKDIR /app

# 3. Copy package definitions first (leverages Docker layer cache)
COPY package*.json ./

# 4. Install production dependencies
RUN npm ci --omit=dev

# 5. Copy the rest of the backend source code
COPY . .

# 6. Expose the server port
EXPOSE 5000

# 7. Start the application
CMD ["node", "server.js"]